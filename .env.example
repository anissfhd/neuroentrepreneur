# Copier ce fichier en .env pour une configuration locale. Ne jamais versionner .env.

# Emplacement des bases SQLite locales (metier et checkpoints).
NEUROCOACH_DATA_DIR=./data

# Fournisseur LLM : fake (defaut, tests et demo hors ligne), anthropic ou openai.
# Fournisseur reel : installer l'extra (pip install -e ".[anthropic]" ou ".[openai]"),
# choisir le modele (ex. Anthropic : claude-opus-5-5, ou claude-sonnet-5-5, moins cher)
# et renseigner la cle plus bas. Verification : python scripts/dev.py check-llm
NEUROCOACH_LLM_PROVIDER=fake
NEUROCOACH_LLM_MODEL=
NEUROCOACH_LLM_TIMEOUT_SECONDS=30
# Plafond par appel. La reflexion des modeles qui raisonnent (Claude recents, gpt-5) y compte.
NEUROCOACH_LLM_MAX_OUTPUT_TOKENS=4000
# Effort de reflexion (Claude recents, gpt-5, o-series) : low, medium ou high ; vide = defaut.
NEUROCOACH_LLM_EFFORT=

# Configuration par role (facultative, docs/MULTI_MODEL_DESIGN.md). Une variable absente ou
# vide reprend la valeur commune ci-dessus. Roles : COACHING, STRATEGY, SIMPLE. Modeles
# declares : src/neurocoach/llm_models.toml. Routage par role actif depuis M2 : une variable
# de role n'est utilisee que si elle est definie, et elle est validee au demarrage.
# NEUROCOACH_LLM_PROVIDER_COACHING=
# NEUROCOACH_LLM_MODEL_COACHING=
# NEUROCOACH_LLM_EFFORT_COACHING=
# NEUROCOACH_LLM_MODEL_STRATEGY=
# NEUROCOACH_LLM_MODEL_SIMPLE=

# Expiration des propositions en attente de confirmation.
NEUROCOACH_PENDING_ACTION_TTL_MINUTES=15

# Fuseau d'affichage par defaut (nom IANA).
NEUROCOACH_DEFAULT_TIMEZONE=Europe/Paris

# Cles des fournisseurs reels : a renseigner uniquement dans .env local (jamais dans Git).
# Lues a part, jamais affichees ni journalisees. Laisser LANGSMITH_TRACING desactive.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tests de dialogue avec le fournisseur reel (payants, jamais en CI) : mettre 1 pour activer.
NEUROCOACH_RUN_REAL_LLM=0

# Business Researcher (recherche web reelle, R2). Cles gratuites a creer soi-meme :
# Tavily (1 000 credits par mois, sans carte) et Exa (10 $ par mois, sans carte). Ne jamais
# ajouter de moyen de paiement si l'on veut exclure toute facturation. Lues a part, jamais
# affichees ni journalisees. Une cle absente = service non utilise. Les deux sont facultatives.
TAVILY_API_KEY=
EXA_API_KEY=
# Recherche simulee (demonstration hors ligne uniquement ; resultats fictifs signales) : 1.
NEUROCOACH_RESEARCH_SIMULATION=0
NEUROCOACH_RESEARCH_TIMEOUT_SECONDS=20
